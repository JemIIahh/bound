# local dev only: the sqlite file next to where you run the server.
# docker-compose.yml forces DATABASE_PATH=/data/bound.db (named volume), so this value is ignored in the container.
>>>>>>> c7f17ce (chore: deploy)
DATABASE_PATH=./bound.db
PORT=8787
WEB_ORIGIN=http://localhost:3000
# optional: demo org root key so the lab can auto-sign approvals (demo only; keep unset on mainnet unless filming)
DEMO_ROOT_PRIVATE_KEY=
# optional: the only org POST /v1/orgs/:orgId/authorize-demo will sign for (demo:seed writes it).
# Set it whenever DEMO_ROOT_PRIVATE_KEY is set on a public server, so nobody can make the demo key sign for their own org.
DEMO_ORG_ID=
# attack lab (guard-off demo): always available on testnet; on mainnet only when set to true
# (on mainnet this also enables guarded lab runs, which can make real payments to approved payees)
LAB_ENABLED=false
# public demo (/try): testnet only. The org it runs on, never DEMO_ORG_ID (demo:public-org writes it);
# unset, or with ANTHROPIC_API_KEY empty, the public demo answers 503.
DEMO_PUBLIC_ORG_ID=
# Runs per client IP per hour, and per rolling 24 hours for everyone (0 pauses the demo)
DEMO_RUNS_PER_IP_HOUR=6
DEMO_RUNS_PER_DAY=300
# Paid-API demo (/v1/demo/api-runs, testnet only; README "Guarding MPP payments"): real 0.01 pathUSD payments from
# DEMO_PUBLIC_ORG_ID per run; runs per rolling 24 hours for everyone (0 pauses it; the per-IP limit is DEMO_RUNS_PER_IP_HOUR).
# The public demo org's allowlist must hold the honest wallet: pnpm --filter @bound/server demo:public-allow-acme
DEMO_API_RUNS_PER_DAY=200
# HMAC key (at least 32 bytes, or the server refuses to start) binding the demo paid API's 402 challenges; empty = derived from SERVER_SECRET
MPP_SECRET_KEY=
# The demo API's honest wallet (Acme; demo:keys writes it) and the wallet the hijacked API names (demo:lookalike writes it).
# Empty = on testnet, the README's public deployment; never defaulted on mainnet. A malformed address stops the server.
DEMO_PAYEE_ADDRESS=
LAB_LOOKALIKE_ADDRESS=
# early-access sign-ups (POST /v1/signups) per client IP per hour
SIGNUPS_PER_IP_HOUR=10

# ---- testnet demo scripts only (apps/server/scripts; the server ignores these) ----
# DEPLOYER_PRIVATE_KEY=      deploys BoundRegistry (demo:deploy)
# DEMO_PAYEE_PRIVATE_KEY=    the demo payee "Acme Ltd" wallet (demo:seed)
# DEMO_PAYEE_DOMAIN=         domain to attest for Acme (default acme.example)
# DEMO_ORG_TOKEN=            written by demo:seed with DEMO_ORG_ID (the token is a demo credential)
# DEMO_PUBLIC_ORG_TOKEN=     written by demo:public-org with DEMO_PUBLIC_ORG_ID (never printed)
# LAB_LOOKALIKE_PRIVATE_KEY= written by demo:lookalike (first 4 + last 4 hex chars of the payee wallet)
# LAB_UNREGISTERED_ADDRESS=  a wallet nobody registered (demo:keys)
