# Copy to apps/web/.env.local (the server's demo scripts write it for you on testnet)
# Bound REST API (apps/server)
NEXT_PUBLIC_API_URL=http://localhost:8787
# testnet | mainnet
NEXT_PUBLIC_TEMPO_NETWORK=testnet

# Attack lab presets (/app/<orgId>/lab and the public /try, which hides a preset whose wallet is unset).
# The server's seed-demo.ts and mine-lookalike.ts produce these;
# the testnet demo values are in the README.
# Name and domain of the verified demo payee (defaults: "Acme Ltd", acme.com)
NEXT_PUBLIC_LAB_PAYEE_NAME=Acme Ltd
NEXT_PUBLIC_LAB_PAYEE_DOMAIN=acme.com
# The demo payee's verified wallet ("Real Acme invoice")
NEXT_PUBLIC_LAB_PAYEE_WALLET=
# Pre-mined lookalike of the payee wallet, same first and last characters ("Changed wallet", "Injected + guard off")
NEXT_PUBLIC_LAB_LOOKALIKE=
# A fresh wallet nobody verified ("Compromised real domain")
NEXT_PUBLIC_LAB_UNREGISTERED=
